# Configuration de la base de données
DB_HOST=postgres
DB_PORT=5432
DB_NAME=peintreab_db
DB_USER=peintreab_user
DB_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION
DB_SSL=false

# Configuration JWT (clé aléatoire ≥ 24 caractères — obligatoire en production)
JWT_SECRET=CHANGEZ_MOI_EN_PRODUCTION_AVEC_UNE_CLE_SECRETE_TRES_LONGUE_ET_ALEATOIRE
JWT_EXPIRES_IN=12h

# Comptes admin créés à la migration s’ils n’existent pas encore
# (mot de passe temporaire → à changer via « Mot de passe oublié »)
ADMIN_EMAIL=alexandre.bindl@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_EMAIL_2=meriemzahzouh@gmail.com
ADMIN_PASSWORD_2=admin123

# Configuration du serveur
PORT=3000
NODE_ENV=development
# Production NAS : https://www.alexandre-bindl.fr
FRONTEND_URL=http://localhost:5173

# Configuration email
#
# DEV (toi, développeur) — Mailpit, AUCUN mot de passe Gmail :
# docker-compose.yml force déjà Mailpit. Les mails s’affichent sur http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=dev@peintreab.local
EMAIL_FROM=dev@peintreab.local
EMAIL_PASSWORD=

# PROD (NAS) — configuré par le client / artiste, PAS par le développeur :
# Il crée lui-même un « mot de passe d’application » Google et le met dans
# backend/.env sur le NAS uniquement. Ne jamais demander le mot de passe Gmail.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=alexandre.bindl@gmail.com
# EMAIL_PASSWORD=mot-de-passe-application-16-caracteres
# EMAIL_FROM=alexandre.bindl@gmail.com
# ADMIN_NOTIFY_EMAIL=alexandre.bindl@gmail.com
