# Configuration de la base de données
DB_HOST=postgres
DB_PORT=5432
DB_NAME=peintreab_db
DB_USER=peintreab_user
DB_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION
DB_SSL=false

# Configuration JWT
JWT_SECRET=CHANGEZ_MOI_EN_PRODUCTION_AVEC_UNE_CLE_SECRETE_TRES_LONGUE_ET_ALEATOIRE
JWT_EXPIRES_IN=7d

# Configuration du serveur
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Configuration email (backend/.env monté dans Docker — une seule config active)
#
# Option B — Dev local (recommandé avec docker compose) :
# Les messages n’apparaissent dans Mailpit QUE si SMTP pointe vers le conteneur mailpit.
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_USER=dev@peintreab.local
# EMAIL_FROM=dev@peintreab.local
# EMAIL_PASSWORD=
# → interface http://localhost:8025 (aucun email réel)
#
# Option A — Vrais emails (Gmail) : Mailpit restera vide (normal).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre-email@gmail.com
# Mot de passe d'application Google (16 caractères, sans espaces)
EMAIL_PASSWORD=votre-app-password-gmail
EMAIL_FROM=votre-email@gmail.com
# Destinataire des alertes « nouveau message » admin (défaut : EMAIL_USER)
# ADMIN_NOTIFY_EMAIL=alexandre.bindl@gmail.com

# Note: Pour Gmail, vous devez créer un "App Password" :
# 1. Allez dans votre compte Google
# 2. Sécurité > Validation en deux étapes (doit être activée)
# 3. Mots de passe des applications > Créer un mot de passe
# 4. Utilisez ce mot de passe ici
